// Cisco FTD traffic to Claude/Anthropic.
// Platform: Sentinel, CommonSecurityLog (Cisco ASA/FTD connector).
// FTD syslog often has IPs only: falls back to IPs learned from MDE DeviceNetworkEvents
// plus Anthropic's published API range. CDN-shared IPs can cause false positives - treat IP-only hits as leads.
let ClaudeDomains = dynamic(["claude.ai", "claude.com", "anthropic.com", "claudeusercontent.com"]);
let ClaudeIPs = DeviceNetworkEvents
    | where TimeGenerated > ago(30d) and RemoteUrl has_any (ClaudeDomains)
    | distinct RemoteIP;
CommonSecurityLog
| where TimeGenerated > ago(30d)
| where DeviceVendor == "Cisco" and DeviceProduct has_any ("ASA", "FTD", "Firepower")
| where RequestURL has_any (ClaudeDomains)
    or DestinationHostName has_any (ClaudeDomains)
    or Message has_any (ClaudeDomains)
    or DestinationIP in (ClaudeIPs)
    or ipv4_is_in_range(DestinationIP, "160.79.104.0/23")   // verify against Anthropic's published IP docs
| summarize Events = count(), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated),
            Actions = make_set(DeviceAction)
    by SourceIP, DestinationIP, DestinationHostName, RequestURL
| order by Events desc
